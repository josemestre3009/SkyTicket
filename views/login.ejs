<section class="auth card">
  <p class="auth__brand"><span class="brand__mark" aria-hidden="true"><svg class="icon" focusable="false"><use href="#i-brand"/></svg></span> SkyTicket</p>
  <h1 class="card__title">Iniciar sesión</h1>
  <p class="muted">Accede con tu cuenta de SkyTicket.</p>
  <form method="post" action="/login" class="form" novalidate>
    <input type="hidden" name="next" value="<%= next %>" />
    <div class="field">
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" autocomplete="username" required
             inputmode="email" value="<%= email %>" />
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <button type="submit" class="btn btn--primary btn--block" data-loading>
      <span class="btn__label">Ingresar</span>
    </button>
  </form>
</section>
