<!DOCTYPE html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <!--
      SkyTicket UI · Dirección fijada por el usuario (decidida, no negociable):
      Apple Settings, tema claro permanente, densidad cómoda, sidebar vertical.
      Pinned: sin dark mode, sin gradientes decorativos, superficies blancas.
      No reinterpretar; este contrato gobierna pantallas nuevas.
    -->
    <title><%= title === 'SkyTicket' ? title : title + ' · SkyTicket' %></title>
    <link rel="stylesheet" href="/assets/app.css" />
    <script defer src="/assets/app.js"></script>
  </head>
  <body class="app<%= user ? ' app--shell' : '' %>">
    <svg class="icon-sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <symbol id="i-dashboard" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/></g></symbol>
      <symbol id="i-people" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.4 20a5.6 5.6 0 0 1 11.2 0"/><path d="M16 5.2a3 3 0 0 1 0 5.6"/><path d="M17.4 14.4A5.6 5.6 0 0 1 20.6 20"/></g></symbol>
      <symbol id="i-catalog" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5h16l-.9 12a1 1 0 0 1-1 .9H5.9a1 1 0 0 1-1-.9L4 7.5Z"/><path d="M9 7.5a3 3 0 0 1 6 0"/></g></symbol>
      <symbol id="i-orders" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5h12v17l-3-1.8-3 1.8-3-1.8-3 1.8v-17Z"/><path d="M9.5 8.5h5M9.5 12h5"/></g></symbol>
      <symbol id="i-voucher" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5A2 2 0 0 1 5.5 6.5h13a2 2 0 0 1 2 2v1.5a2 2 0 0 0 0 4v1.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-1.5a2 2 0 0 0 0-4V8.5Z"/><path d="M14.5 8.5v7" stroke-dasharray="1.5 2.5"/></g></symbol>
      <symbol id="i-bell" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 10a5.5 5.5 0 0 1 11 0c0 4 1.5 5 1.5 5H5s1.5-1 1.5-5Z"/><path d="M10 19a2 2 0 0 0 4 0"/></g></symbol>
      <symbol id="i-audit" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4.5" width="14" height="16" rx="2.5"/><path d="M9 4.5h6v3H9z"/><path d="M9 12h6M9 15.5h4"/></g></symbol>
      <symbol id="i-gear" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.2M12 19v2.2M21.2 12H19M5 12H2.8M18.5 5.5l-1.6 1.6M7.1 16.9l-1.6 1.6M18.5 18.5l-1.6-1.6M7.1 7.1 5.5 5.5"/></g></symbol>
      <symbol id="i-wallet" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="8" cy="14.6" r="1"/></g></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 8.2v7.6M8.2 12h7.6"/></g></symbol>
      <symbol id="i-menu" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></g></symbol>
      <symbol id="i-close" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></g></symbol>
      <symbol id="i-logout" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4.5h3a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-3"/><path d="M10 12h9"/><path d="M13 9l3 3-3 3"/></g></symbol>
      <symbol id="i-brand" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v2a2.5 2.5 0 0 0 0 5v2a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 16.5v-2a2.5 2.5 0 0 0 0-5v-2Z"/><path d="M13 9.5h3.5"/></g></symbol>
    </svg>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <% if (user) { %>
      <div class="scrim" data-nav-scrim hidden aria-hidden="true"></div>
      <aside id="primary-nav" class="sidebar" data-nav>
        <div class="sidebar__head">
          <a class="brand" href="/dashboard">
            <span class="brand__mark" aria-hidden="true"><svg class="icon" focusable="false"><use href="#i-brand"/></svg></span>
            <span class="brand__name">SkyTicket</span>
          </a>
          <button class="sidebar__close" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
            <span class="sr-only" data-nav-label>Cerrar menú</span>
            <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-close"/></svg>
          </button>
        </div>
        <nav class="sidebar__nav" aria-label="Principal">
          <ul class="nav" role="list">
            <% nav.forEach(function (item) { %>
              <li>
                <a class="nav__link<%= activeNav === item.key ? ' is-active' : '' %>" href="<%= item.href %>"<%= activeNav === item.key ? ' aria-current="page"' : '' %>>
                  <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-<%= item.icon %>"/></svg>
                  <span class="nav__label"><%= item.label %></span>
                </a>
              </li>
            <% }); %>
          </ul>
        </nav>
        <div class="sidebar__foot">
          <div class="sidebar__user">
            <span class="sidebar__avatar" aria-hidden="true"><%= (user.email || '?').charAt(0).toUpperCase() %></span>
            <span class="sidebar__identity">
              <span class="sidebar__role"><%= role === 'admin' ? 'Administrador' : 'Revendedor' %></span>
              <span class="sidebar__email"><%= role === 'admin' ? 'Cuenta de administración' : 'Cuenta de revendedor' %></span>
            </span>
          </div>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn--ghost btn--block">
              <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-logout"/></svg>
              <span class="btn__label">Salir</span>
            </button>
          </form>
        </div>
      </aside>
      <div class="content">
        <header class="topbar">
          <button class="topbar__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
            <span class="sr-only" data-nav-label>Abrir menú</span>
            <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-menu"/></svg>
          </button>
          <a class="brand" href="/dashboard">
            <span class="brand__mark" aria-hidden="true"><svg class="icon" focusable="false"><use href="#i-brand"/></svg></span>
            <span class="brand__name">SkyTicket</span>
          </a>
        </header>
        <main id="main" class="main">
          <%- await include('partials/flash') %>
          <%- body %>
        </main>
        <footer class="footer">
          <span>SkyTicket · panel B2B</span>
        </footer>
      </div>
    <% } else { %>
      <main id="main" class="main main--bare">
        <%- await include('partials/flash') %>
        <%- body %>
      </main>
      <footer class="footer">
        <span>SkyTicket · panel B2B</span>
      </footer>
    <% } %>
  </body>
</html>
