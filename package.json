{
  "name": "skyticket",
  "version": "0.1.0",
  "private": true,
  "description": "SkyTicket B2B reseller panel for Ruijie Cloud Wi-Fi vouchers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/migrate.js",
    "bootstrap": "node src/cli/bootstrap-admin.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "load": "node scripts/load-emissions.js"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
