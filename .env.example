# SkyTicket environment template. Copy to .env and fill values.
# Never commit real secrets. The repository .gitignore excludes .env.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Host port published by docker compose for the web service
WEB_PORT=3000
# Trust X-Forwarded-* headers. Keep false unless running behind a known proxy.
TRUST_PROXY=false

# --- PostgreSQL ---
POSTGRES_USER=skyticket
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=skyticket
# Used by host commands (migrate/tests). Inside compose the host "db" is used automatically.
DATABASE_URL=postgres://skyticket:change_me_local_only@localhost:5432/skyticket

# --- Application encryption (AES-256-GCM, versioned) ---
# Generate a 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=primary
# Optional rotation keyring, JSON map of keyId -> base64 key (used to decrypt older ciphertext)
APP_ENCRYPTION_KEYS=

# --- Sessions ---
SESSION_SECRET=
SESSION_COOKIE_NAME=skyticket_sid

# --- Admin bootstrap ---
ADMIN_EMAIL=

# --- Ruijie Cloud integration (backend only) ---
# Master gate for real emission/sync. Keep false until the sandbox checklist
# (task 7.7) is signed off; when false no outbound Ruijie call is ever made.
RUIJIE_LIVE_ENABLED=false
# Read-only inventory (group tree + voucher listing). Independent from emission.
# Defaults to true only when RUIJIE_APP_ID and RUIJIE_APP_SECRET are present.
RUIJIE_READ_ENABLED=
RUIJIE_BASE_URL=https://cloud-eu.ruijienetworks.com
RUIJIE_REGION=eu
RUIJIE_APP_ID=
RUIJIE_APP_SECRET=
# Manual/constant API token from the Ruijie manual (distinct from access_token)
RUIJIE_API_TOKEN=

# --- Email notifications (worker) ---
SMTP_URL=
MAIL_FROM=no-reply@skyticket.local

# --- Jobs and reconciliation thresholds ---
# Job lease must exceed the slowest handler; thresholds gate recovery/reconcile.
JOB_LEASE_MS=60000
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_CAP_MS=300000
RECONCILE_HOLD_GRACE_MS=900000
RECONCILE_STUCK_ORDER_MS=1800000
WORKER_MAINTENANCE_INTERVAL_MS=60000
